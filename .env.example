# Port du serveur
PORT=3000

# Mot de passe admin EN CLAIR utilisé une seule fois pour générer le hash (voir README)
# Ne jamais committer le vrai mot de passe.
ADMIN_PASSWORD_HASH=remplace_moi_par_le_hash_bcrypt

# Clé secrète pour signer les JWT (générer une chaîne aléatoire longue)
JWT_SECRET=remplace_moi_par_une_chaine_aleatoire_longue

# Origine autorisée pour les appels API (ton nom de domaine en prod)
FRONTEND_ORIGIN=http://localhost:3000

# Environnement
NODE_ENV=development
